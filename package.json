{
  "name": "idea-wedge-playbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:plugin": "tsc -p mcp/tsconfig.json && node scripts/build-plugin.mjs",
    "test:mcp": "tsx --test mcp/*.test.ts",
    "mcp": "node --env-file=.env.local plugin/idea-wedge/server/index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript-slugify": "^1.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "zod": "^3.25.76"
  }
}
